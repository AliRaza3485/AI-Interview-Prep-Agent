# Copy this file to .env.local and set your backend URL.
# cp .env.example .env.local
#
# Server-only (no NEXT_PUBLIC_ prefix) — the browser never sees this.
# The Next.js API routes under app/api/* proxy to it, so the FastAPI
# backend's address is never exposed to the client and mixed-content
# (HTTPS Vercel -> HTTP EC2) is avoided.
BACKEND_URL=http://localhost:8000
